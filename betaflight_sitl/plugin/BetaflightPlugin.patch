+void BetaflightPluginPrivate::PublishOdometry(EntityComponentManager &_ecm,
+    const std::chrono::steady_clock::duration &_simTime)
+{
+  if (!this->odomPub)
+    return;
+
+  if (this->odomPubPeriod > std::chrono::steady_clock::duration::zero() &&
+      _simTime - this->lastOdomPubTime < this->odomPubPeriod &&
+      _simTime >= this->lastOdomPubTime)
+  {
+    return;
+  }
+
+  auto linearComp =
+    _ecm.Component<components::WorldLinearVelocity>(this->modelLinkEntity);
+  auto angularComp =
+    _ecm.Component<components::WorldAngularVelocity>(this->modelLinkEntity);
+  if (!linearComp || !angularComp)
+    return;
+
+  const gz::math::Pose3d pose = worldPose(this->modelLinkEntity, _ecm);
+  // Express both twists in the body frame: that is the convention the
+  // Agilicious pipeline and the Betaflight rate loop both work in.
+  const gz::math::Vector3d bodyLinear =
+    pose.Rot().RotateVectorReverse(linearComp->Data());
+  const gz::math::Vector3d bodyAngular =
+    pose.Rot().RotateVectorReverse(angularComp->Data());
+
+  msgs::Odometry msg;
+  const std::chrono::duration<double> stamp(_simTime);
+  const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(stamp);
+  msg.mutable_header()->mutable_stamp()->set_sec(seconds.count());
+  msg.mutable_header()->mutable_stamp()->set_nsec(
+    static_cast<int32_t>((stamp - seconds).count() * 1e9));
+
+  msgs::Set(msg.mutable_pose()->mutable_position(), pose.Pos());
+  msgs::Set(msg.mutable_pose()->mutable_orientation(), pose.Rot());
+  msgs::Set(msg.mutable_twist()->mutable_linear(), bodyLinear);
+  msgs::Set(msg.mutable_twist()->mutable_angular(), bodyAngular);
+
+  this->odomPub.Publish(msg);
+  this->lastOdomPubTime = _simTime;
+}
