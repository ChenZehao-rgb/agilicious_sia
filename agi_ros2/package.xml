<?xml version="1.0"?>
<package format="3">
  <name>agi_ros2</name><version>0.1.0</version>
  <description>Shared Agilicious ROS 2 control and Betaflight adapters</description>
  <maintainer email="maintainer@example.com">Agilicious maintainers</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>builtin_interfaces</depend><depend>rclcpp</depend><depend>sensor_msgs</depend><depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend><depend>std_msgs</depend><depend>rosgraph_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <test_depend>rosbag2_py</test_depend>
  <exec_depend>rosbag2</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
